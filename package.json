{
  "name": "web-boot-runner",
  "displayName": "Web Boot Runner",
  "description": "%description%",
  "version": "0.1.10",
  "publisher": "liuhualiang",
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://github.com/eppen/vscode-web-boot#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/eppen/vscode-web-boot.git"
  },
  "bugs": {
    "url": "https://github.com/eppen/vscode-web-boot/issues"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "Debuggers"
  ],
  "keywords": [
    "spring-boot",
    "springboot",
    "spring",
    "maven",
    "java",
    "multi-module",
    "reactor",
    "profile",
    "port",
    "jacoco",
    "run",
    "debug"
  ],
  "galleryBanner": {
    "color": "#12232e",
    "theme": "dark"
  },
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:pom.xml"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "webBoot",
          "title": "Web Boot",
          "icon": "media/web-boot.svg"
        }
      ]
    },
    "views": {
      "webBoot": [
        {
          "id": "webBoot.apps",
          "name": "%view.apps.name%",
          "icon": "media/web-boot.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "webBoot.apps",
        "contents": "%view.apps.welcome%"
      }
    ],
    "commands": [
      {
        "command": "webBoot.refresh",
        "title": "%command.refresh%",
        "category": "Web Boot",
        "icon": "$(refresh)"
      },
      {
        "command": "webBoot.run",
        "title": "%command.run%",
        "category": "Web Boot",
        "icon": "$(play)"
      },
      {
        "command": "webBoot.runWithProfile",
        "title": "%command.runWithProfile%",
        "category": "Web Boot",
        "icon": "$(settings-gear)"
      },
      {
        "command": "webBoot.runWithPort",
        "title": "%command.runWithPort%",
        "category": "Web Boot",
        "icon": "$(plug)"
      },
      {
        "command": "webBoot.edit",
        "title": "%command.edit%",
        "category": "Web Boot",
        "icon": "$(edit)"
      },
      {
        "command": "webBoot.createGroup",
        "title": "%command.createGroup%",
        "category": "Web Boot",
        "icon": "$(new-folder)"
      },
      {
        "command": "webBoot.renameGroup",
        "title": "%command.renameGroup%",
        "category": "Web Boot",
        "icon": "$(edit)"
      },
      {
        "command": "webBoot.deleteGroup",
        "title": "%command.deleteGroup%",
        "category": "Web Boot",
        "icon": "$(trash)"
      },
      {
        "command": "webBoot.moveAppToGroup",
        "title": "%command.moveAppToGroup%",
        "category": "Web Boot",
        "icon": "$(folder)"
      },
      {
        "command": "webBoot.startGroup",
        "title": "%command.startGroup%",
        "category": "Web Boot",
        "icon": "$(play)"
      },
      {
        "command": "webBoot.debugGroup",
        "title": "%command.debugGroup%",
        "category": "Web Boot",
        "icon": "$(debug-alt)"
      },
      {
        "command": "webBoot.stopGroup",
        "title": "%command.stopGroup%",
        "category": "Web Boot",
        "icon": "$(debug-stop)"
      },
      {
        "command": "webBoot.debug",
        "title": "%command.debug%",
        "category": "Web Boot",
        "icon": "$(debug-alt)"
      },
      {
        "command": "webBoot.stop",
        "title": "%command.stop%",
        "category": "Web Boot",
        "icon": "$(debug-stop)"
      },
      {
        "command": "webBoot.restart",
        "title": "%command.restart%",
        "category": "Web Boot",
        "icon": "$(debug-restart)"
      },
      {
        "command": "webBoot.processResources",
        "title": "%command.processResources%",
        "category": "Web Boot",
        "icon": "$(files)"
      },
      {
        "command": "webBoot.sampleCoverage",
        "title": "%command.sampleCoverage%",
        "category": "Web Boot",
        "icon": "$(pulse)"
      },
      {
        "command": "webBoot.openCoverageReport",
        "title": "%command.openCoverageReport%",
        "category": "Web Boot",
        "icon": "$(file-media)"
      },
      {
        "command": "webBoot.open",
        "title": "%command.open%",
        "category": "Web Boot",
        "icon": "$(globe)"
      },
      {
        "command": "webBoot.copyCommand",
        "title": "%command.copyCommand%",
        "category": "Web Boot",
        "icon": "$(copy)"
      },
      {
        "command": "webBoot.checkPortConflicts",
        "title": "%command.checkPortConflicts%",
        "category": "Web Boot",
        "icon": "$(warning)"
      },
      {
        "command": "webBoot.killPort",
        "title": "%command.killPort%",
        "category": "Web Boot",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "webBoot.generateLaunchJson",
        "title": "%command.generateLaunchJson%",
        "category": "Web Boot",
        "icon": "$(json)"
      },
      {
        "command": "webBoot.showOutput",
        "title": "%command.showOutput%",
        "category": "Web Boot",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "webBoot.run",
          "when": "false"
        },
        {
          "command": "webBoot.runWithProfile",
          "when": "false"
        },
        {
          "command": "webBoot.runWithPort",
          "when": "false"
        },
        {
          "command": "webBoot.edit",
          "when": "false"
        },
        {
          "command": "webBoot.renameGroup",
          "when": "false"
        },
        {
          "command": "webBoot.deleteGroup",
          "when": "false"
        },
        {
          "command": "webBoot.moveAppToGroup",
          "when": "false"
        },
        {
          "command": "webBoot.startGroup",
          "when": "false"
        },
        {
          "command": "webBoot.debugGroup",
          "when": "false"
        },
        {
          "command": "webBoot.stopGroup",
          "when": "false"
        },
        {
          "command": "webBoot.debug",
          "when": "false"
        },
        {
          "command": "webBoot.stop",
          "when": "false"
        },
        {
          "command": "webBoot.restart",
          "when": "false"
        },
        {
          "command": "webBoot.processResources",
          "when": "false"
        },
        {
          "command": "webBoot.sampleCoverage",
          "when": "false"
        },
        {
          "command": "webBoot.openCoverageReport",
          "when": "false"
        },
        {
          "command": "webBoot.open",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "webBoot.refresh",
          "when": "view == webBoot.apps",
          "group": "navigation@1"
        },
        {
          "command": "webBoot.checkPortConflicts",
          "when": "view == webBoot.apps",
          "group": "navigation@2"
        },
        {
          "command": "webBoot.killPort",
          "when": "view == webBoot.apps",
          "group": "navigation@3"
        },
        {
          "command": "webBoot.generateLaunchJson",
          "when": "view == webBoot.apps",
          "group": "navigation@4"
        },
        {
          "command": "webBoot.showOutput",
          "when": "view == webBoot.apps",
          "group": "navigation@5"
        },
        {
          "command": "webBoot.createGroup",
          "when": "view == webBoot.apps",
          "group": "navigation@6"
        }
      ],
      "view/item/context": [
        {
          "command": "webBoot.run",
          "when": "view == webBoot.apps && viewItem == bootApp.stopped",
          "group": "inline@1"
        },
        {
          "command": "webBoot.debug",
          "when": "view == webBoot.apps && viewItem == bootApp.stopped",
          "group": "inline@2"
        },
        {
          "command": "webBoot.edit",
          "when": "view == webBoot.apps && viewItem == bootApp.stopped",
          "group": "inline@3"
        },
        {
          "command": "webBoot.open",
          "when": "view == webBoot.apps && viewItem == bootApp.running",
          "group": "inline@1"
        },
        {
          "command": "webBoot.stop",
          "when": "view == webBoot.apps && viewItem == bootApp.running",
          "group": "inline@2"
        },
        {
          "command": "webBoot.restart",
          "when": "view == webBoot.apps && viewItem == bootApp.running",
          "group": "inline@3"
        },
        {
          "command": "webBoot.edit",
          "when": "view == webBoot.apps && viewItem == bootApp.running",
          "group": "inline@4"
        },
        {
          "command": "webBoot.startGroup",
          "when": "view == webBoot.apps && viewItem == bootGroup",
          "group": "inline@1"
        },
        {
          "command": "webBoot.debugGroup",
          "when": "view == webBoot.apps && viewItem == bootGroup",
          "group": "inline@2"
        },
        {
          "command": "webBoot.stopGroup",
          "when": "view == webBoot.apps && viewItem == bootGroup",
          "group": "inline@3"
        },
        {
          "command": "webBoot.run",
          "when": "view == webBoot.apps && viewItem == bootApp.stopped",
          "group": "1_run@1"
        },
        {
          "command": "webBoot.runWithProfile",
          "when": "view == webBoot.apps && viewItem == bootApp.stopped",
          "group": "1_run@2"
        },
        {
          "command": "webBoot.runWithPort",
          "when": "view == webBoot.apps && viewItem == bootApp.stopped",
          "group": "1_run@3"
        },
        {
          "command": "webBoot.debug",
          "when": "view == webBoot.apps && viewItem == bootApp.stopped",
          "group": "1_run@4"
        },
        {
          "command": "webBoot.copyCommand",
          "when": "view == webBoot.apps && viewItem == bootApp.stopped",
          "group": "2_tools@1"
        },
        {
          "command": "webBoot.edit",
          "when": "view == webBoot.apps && viewItem == bootApp.stopped",
          "group": "2_tools@2"
        },
        {
          "command": "webBoot.moveAppToGroup",
          "when": "view == webBoot.apps && viewItem == bootApp.stopped",
          "group": "2_tools@3"
        },
        {
          "command": "webBoot.sampleCoverage",
          "when": "view == webBoot.apps && viewItem == bootApp.stopped",
          "group": "2_tools@4"
        },
        {
          "command": "webBoot.openCoverageReport",
          "when": "view == webBoot.apps && viewItem == bootApp.stopped",
          "group": "2_tools@5"
        },
        {
          "command": "webBoot.killPort",
          "when": "view == webBoot.apps && viewItem == bootApp.stopped",
          "group": "2_tools@6"
        },
        {
          "command": "webBoot.stop",
          "when": "view == webBoot.apps && viewItem == bootApp.running",
          "group": "1_run@1"
        },
        {
          "command": "webBoot.restart",
          "when": "view == webBoot.apps && viewItem == bootApp.running",
          "group": "1_run@2"
        },
        {
          "command": "webBoot.open",
          "when": "view == webBoot.apps && viewItem == bootApp.running",
          "group": "2_tools@1"
        },
        {
          "command": "webBoot.edit",
          "when": "view == webBoot.apps && viewItem == bootApp.running",
          "group": "2_tools@2"
        },
        {
          "command": "webBoot.moveAppToGroup",
          "when": "view == webBoot.apps && viewItem == bootApp.running",
          "group": "2_tools@3"
        },
        {
          "command": "webBoot.processResources",
          "when": "view == webBoot.apps && viewItem == bootApp.running",
          "group": "2_tools@4"
        },
        {
          "command": "webBoot.sampleCoverage",
          "when": "view == webBoot.apps && viewItem == bootApp.running",
          "group": "2_tools@5"
        },
        {
          "command": "webBoot.openCoverageReport",
          "when": "view == webBoot.apps && viewItem == bootApp.running",
          "group": "2_tools@6"
        },
        {
          "command": "webBoot.startGroup",
          "when": "view == webBoot.apps && viewItem == bootGroup",
          "group": "1_group@1"
        },
        {
          "command": "webBoot.debugGroup",
          "when": "view == webBoot.apps && viewItem == bootGroup",
          "group": "1_group@2"
        },
        {
          "command": "webBoot.stopGroup",
          "when": "view == webBoot.apps && viewItem == bootGroup",
          "group": "1_group@3"
        },
        {
          "command": "webBoot.renameGroup",
          "when": "view == webBoot.apps && viewItem == bootGroup",
          "group": "2_group@1"
        },
        {
          "command": "webBoot.deleteGroup",
          "when": "view == webBoot.apps && viewItem == bootGroup",
          "group": "2_group@2"
        }
      ]
    },
    "configuration": {
      "title": "Web Boot Runner",
      "properties": {
        "webBoot.mavenCommand": {
          "type": "string",
          "default": "mvn",
          "markdownDescription": "%config.mavenCommand%"
        },
        "webBoot.preBuild": {
          "type": "string",
          "enum": [
            "none",
            "compile",
            "package",
            "install"
          ],
          "enumDescriptions": [
            "%config.preBuild.none%",
            "%config.preBuild.compile%",
            "%config.preBuild.package%",
            "%config.preBuild.install%"
          ],
          "default": "compile",
          "description": "%config.preBuild.description%"
        },
        "webBoot.buildDependencies": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.buildDependencies%"
        },
        "webBoot.monitor": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.monitor%"
        },
        "webBoot.debugPort": {
          "type": "number",
          "default": 5005,
          "description": "%config.debugPort%"
        },
        "webBoot.runner": {
          "type": "string",
          "enum": [
            "outputChannel",
            "terminal"
          ],
          "enumDescriptions": [
            "%config.runner.outputChannel%",
            "%config.runner.terminal%"
          ],
          "default": "outputChannel",
          "description": "%config.runner.description%"
        },
        "webBoot.autoAttach": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoAttach%"
        },
        "webBoot.autoOpen": {
          "type": "boolean",
          "default": false,
          "description": "%config.autoOpen%"
        },
        "webBoot.javaHome": {
          "type": "string",
          "default": "",
          "description": "%config.javaHome%"
        },
        "webBoot.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.extraArgs%"
        },
        "webBoot.coverage": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.coverage%"
        },
        "webBoot.coveragePort": {
          "type": "number",
          "default": 6300,
          "description": "%config.coveragePort%"
        },
        "webBoot.coverageJacocoVersion": {
          "type": "string",
          "default": "0.8.13",
          "description": "%config.coverageJacocoVersion%"
        },
        "webBoot.language": {
          "type": "string",
          "enum": [
            "auto",
            "zh-cn",
            "en",
            "ja"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.zh-cn%",
            "%config.language.en%",
            "%config.language.ja%"
          ],
          "default": "auto",
          "description": "%config.language.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "selfcheck": "esbuild test/scan.ts --bundle --platform=node --format=cjs --alias:vscode=./test/vscode-stub.ts --outfile=test/.tmp/scan.cjs --log-level=error && node test/.tmp/scan.cjs",
    "selfcheck:cmd": "esbuild test/command.ts --bundle --platform=node --format=cjs --alias:vscode=./test/vscode-stub.ts --outfile=test/.tmp/command.cjs --log-level=error && node test/.tmp/command.cjs",
    "selfcheck:parse": "esbuild test/parse.ts --bundle --platform=node --format=cjs --outfile=test/.tmp/parse.cjs --log-level=error && node test/.tmp/parse.cjs",
    "selfcheck:monitor": "esbuild test/monitor.ts --bundle --platform=node --format=cjs --alias:vscode=./test/vscode-stub.ts --outfile=test/.tmp/monitor.cjs --log-level=error && node test/.tmp/monitor.cjs",
    "selfcheck:proc": "esbuild test/proc.ts --bundle --platform=node --format=cjs --outfile=test/.tmp/proc.cjs --log-level=error && node test/.tmp/proc.cjs",
    "selfcheck:port": "esbuild test/portOwner.ts --bundle --platform=node --format=cjs --outfile=test/.tmp/portOwner.cjs --log-level=error && node test/.tmp/portOwner.cjs",
    "selfcheck:encoding": "esbuild test/encoding.ts --bundle --platform=node --format=cjs --outfile=test/.tmp/encoding.cjs --log-level=error && node test/.tmp/encoding.cjs",
    "selfcheck:coverage": "esbuild test/coverage.ts --bundle --platform=node --format=cjs --outfile=test/.tmp/coverage.cjs --log-level=error && node test/.tmp/coverage.cjs",
    "selfcheck:i18n": "esbuild test/i18n.ts --bundle --platform=node --format=cjs --outfile=test/.tmp/i18n.cjs --log-level=error && node test/.tmp/i18n.cjs",
    "selfcheck:state": "esbuild test/state.ts --bundle --platform=node --format=cjs --outfile=test/.tmp/state.cjs --log-level=error && node test/.tmp/state.cjs",
    "selfcheck:adopt": "esbuild test/adopt.ts --bundle --platform=node --format=cjs --alias:vscode=./test/vscode-stub.ts --outfile=test/.tmp/adopt.cjs --log-level=error && node test/.tmp/adopt.cjs",
    "selfcheck:all": "npm run selfcheck && npm run selfcheck:cmd && npm run selfcheck:parse && npm run selfcheck:monitor && npm run selfcheck:proc && npm run selfcheck:port && npm run selfcheck:encoding && npm run selfcheck:coverage && npm run selfcheck:i18n && npm run selfcheck:state && npm run selfcheck:adopt",
    "vscode:prepublish": "npm run build",
    "package": "npm run build && vsce package --no-dependencies",
    "publish": "npm run typecheck && vsce publish --no-dependencies"
  },
  "dependencies": {
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "1.75.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.20.2",
    "typescript": "^5.4.5"
  }
}
