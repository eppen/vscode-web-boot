{
  "name": "web-boot-runner",
  "displayName": "Web Boot Runner",
  "description": "在多模块 Maven 工作区中管理 Spring Boot 应用：启动、停止、调试、profile 与端口记忆、端口冲突检测",
  "version": "0.1.0",
  "publisher": "liuhualiang",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "spring-boot",
    "maven",
    "mes"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:pom.xml",
    "onView:webBoot.apps"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "webBoot",
          "title": "Web Boot",
          "icon": "media/web-boot.svg"
        }
      ]
    },
    "views": {
      "webBoot": [
        {
          "id": "webBoot.apps",
          "name": "Spring Boot 应用",
          "icon": "media/web-boot.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "webBoot.apps",
        "contents": "未发现任何 Spring Boot 应用。\n确认当前工作区根目录包含 pom.xml，然后点击刷新。\n[重新扫描](command:webBoot.refresh)"
      }
    ],
    "commands": [
      {
        "command": "webBoot.refresh",
        "title": "刷新应用列表",
        "category": "Web Boot",
        "icon": "$(refresh)"
      },
      {
        "command": "webBoot.run",
        "title": "运行",
        "category": "Web Boot",
        "icon": "$(play)"
      },
      {
        "command": "webBoot.runWithProfile",
        "title": "选择 Profile 运行...",
        "category": "Web Boot",
        "icon": "$(settings-gear)"
      },
      {
        "command": "webBoot.runWithPort",
        "title": "指定端口运行...",
        "category": "Web Boot",
        "icon": "$(plug)"
      },
      {
        "command": "webBoot.edit",
        "title": "编辑 Profile / 端口...",
        "category": "Web Boot",
        "icon": "$(edit)"
      },
      {
        "command": "webBoot.debug",
        "title": "调试运行（自动 attach）",
        "category": "Web Boot",
        "icon": "$(debug-alt)"
      },
      {
        "command": "webBoot.stop",
        "title": "停止",
        "category": "Web Boot",
        "icon": "$(debug-stop)"
      },
      {
        "command": "webBoot.open",
        "title": "在浏览器中打开",
        "category": "Web Boot",
        "icon": "$(globe)"
      },
      {
        "command": "webBoot.copyCommand",
        "title": "复制启动命令",
        "category": "Web Boot",
        "icon": "$(copy)"
      },
      {
        "command": "webBoot.checkPortConflicts",
        "title": "检查端口冲突",
        "category": "Web Boot",
        "icon": "$(warning)"
      },
      {
        "command": "webBoot.generateLaunchJson",
        "title": "生成 launch.json",
        "category": "Web Boot",
        "icon": "$(json)"
      },
      {
        "command": "webBoot.showOutput",
        "title": "显示输出窗口",
        "category": "Web Boot",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "webBoot.run",
          "when": "false"
        },
        {
          "command": "webBoot.runWithProfile",
          "when": "false"
        },
        {
          "command": "webBoot.runWithPort",
          "when": "false"
        },
        {
          "command": "webBoot.edit",
          "when": "false"
        },
        {
          "command": "webBoot.debug",
          "when": "false"
        },
        {
          "command": "webBoot.stop",
          "when": "false"
        },
        {
          "command": "webBoot.open",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "webBoot.refresh",
          "when": "view == webBoot.apps",
          "group": "navigation@1"
        },
        {
          "command": "webBoot.checkPortConflicts",
          "when": "view == webBoot.apps",
          "group": "navigation@2"
        },
        {
          "command": "webBoot.generateLaunchJson",
          "when": "view == webBoot.apps",
          "group": "navigation@3"
        },
        {
          "command": "webBoot.showOutput",
          "when": "view == webBoot.apps",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "webBoot.run",
          "when": "view == webBoot.apps && viewItem == bootApp.stopped",
          "group": "inline@1"
        },
        {
          "command": "webBoot.debug",
          "when": "view == webBoot.apps && viewItem == bootApp.stopped",
          "group": "inline@2"
        },
        {
          "command": "webBoot.edit",
          "when": "view == webBoot.apps && viewItem == bootApp.stopped",
          "group": "inline@3"
        },
        {
          "command": "webBoot.open",
          "when": "view == webBoot.apps && viewItem == bootApp.running",
          "group": "inline@1"
        },
        {
          "command": "webBoot.stop",
          "when": "view == webBoot.apps && viewItem == bootApp.running",
          "group": "inline@2"
        },
        {
          "command": "webBoot.edit",
          "when": "view == webBoot.apps && viewItem == bootApp.running",
          "group": "inline@3"
        },
        {
          "command": "webBoot.run",
          "when": "view == webBoot.apps && viewItem == bootApp.stopped",
          "group": "1_run@1"
        },
        {
          "command": "webBoot.runWithProfile",
          "when": "view == webBoot.apps && viewItem == bootApp.stopped",
          "group": "1_run@2"
        },
        {
          "command": "webBoot.runWithPort",
          "when": "view == webBoot.apps && viewItem == bootApp.stopped",
          "group": "1_run@3"
        },
        {
          "command": "webBoot.debug",
          "when": "view == webBoot.apps && viewItem == bootApp.stopped",
          "group": "1_run@4"
        },
        {
          "command": "webBoot.copyCommand",
          "when": "view == webBoot.apps && viewItem == bootApp.stopped",
          "group": "2_tools@1"
        },
        {
          "command": "webBoot.edit",
          "when": "view == webBoot.apps && viewItem == bootApp.stopped",
          "group": "2_tools@2"
        },
        {
          "command": "webBoot.stop",
          "when": "view == webBoot.apps && viewItem == bootApp.running",
          "group": "1_run@1"
        },
        {
          "command": "webBoot.open",
          "when": "view == webBoot.apps && viewItem == bootApp.running",
          "group": "2_tools@1"
        },
        {
          "command": "webBoot.edit",
          "when": "view == webBoot.apps && viewItem == bootApp.running",
          "group": "2_tools@2"
        }
      ]
    },
    "configuration": {
      "title": "Web Boot Runner",
      "properties": {
        "webBoot.mavenCommand": {
          "type": "string",
          "default": "mvn",
          "markdownDescription": "Maven 可执行文件。Windows 下可为 `mvn`（插件自动补 `.cmd`），也可填绝对路径。"
        },
        "webBoot.preBuild": {
          "type": "string",
          "enum": [
            "none",
            "compile",
            "package",
            "install"
          ],
          "enumDescriptions": [
            "启动前不编译",
            "启动前 mvn compile（默认，够快且能发现编译错误）",
            "启动前 mvn package",
            "启动前 mvn install（依赖模块被其它项目引用时需要）"
          ],
          "default": "compile",
          "description": "启动前执行的 Maven 目标。"
        },
        "webBoot.debugPort": {
          "type": "number",
          "default": 5005,
          "description": "调试端口（JDWP）。被占用时自动向上查找空闲端口。"
        },
        "webBoot.runner": {
          "type": "string",
          "enum": [
            "outputChannel",
            "terminal"
          ],
          "enumDescriptions": [
            "在「Web Boot」输出通道中运行，可检测启动完成、可精确停止",
            "在集成终端中运行，便于手工输入，但无法检测启动完成"
          ],
          "default": "outputChannel",
          "description": "启动进程的承载方式。"
        },
        "webBoot.autoAttach": {
          "type": "boolean",
          "default": true,
          "description": "调试运行时，应用启动完成后自动 attach 到 JDWP 端口。"
        },
        "webBoot.autoOpen": {
          "type": "boolean",
          "default": false,
          "description": "应用启动完成后自动在浏览器打开访问地址。"
        },
        "webBoot.javaHome": {
          "type": "string",
          "default": "",
          "description": "覆盖启动进程使用的 JAVA_HOME。留空则继承当前环境的 JAVA_HOME。"
        },
        "webBoot.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "追加到 spring-boot:run 的额外 JVM 参数（每项一条，如 -Xmx2g）。"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "selfcheck": "esbuild test/scan.ts --bundle --platform=node --format=cjs --alias:vscode=./test/vscode-stub.ts --outfile=test/.tmp/scan.cjs --log-level=error && node test/.tmp/scan.cjs",
    "selfcheck:cmd": "esbuild test/command.ts --bundle --platform=node --format=cjs --alias:vscode=./test/vscode-stub.ts --outfile=test/.tmp/command.cjs --log-level=error && node test/.tmp/command.cjs",
    "selfcheck:parse": "esbuild test/parse.ts --bundle --platform=node --format=cjs --outfile=test/.tmp/parse.cjs --log-level=error && node test/.tmp/parse.cjs",
    "selfcheck:proc": "esbuild test/proc.ts --bundle --platform=node --format=cjs --outfile=test/.tmp/proc.cjs --log-level=error && node test/.tmp/proc.cjs",
    "selfcheck:all": "npm run selfcheck && npm run selfcheck:cmd && npm run selfcheck:parse && npm run selfcheck:proc",
    "vscode:prepublish": "npm run build",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository"
  },
  "dependencies": {
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.2",
    "typescript": "^5.4.5"
  }
}
