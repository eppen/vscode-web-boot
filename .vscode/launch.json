{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "运行扩展（打开 mes-parent）",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${input:targetWorkspace}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "npm: build"
    },
    {
      "name": "运行扩展（当前窗口）",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "npm: build"
    }
  ],
  "inputs": [
    {
      "id": "targetWorkspace",
      "type": "promptString",
      "description": "扩展开发主机启动后打开的目录（应指向 mes-parent 仓库根）",
      "default": "D:/work/jt-mes/source/mes/mes-parent"
    }
  ]
}
